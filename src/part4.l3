#lang racket

; Signature: last-item(lst)
; Type: [List(T1) => T1]
; Purpose: return last item from lst.
; Pre-conditions: (not (eq? lst '()))
; Tests: (last-item '(1 2 3)) => 3; (last-item '(#t #f #f)) => #f
(define last-item
  (λ (lst)
    (if (eq? (cdr lst) '())
      (car lst)
      (last-item (cdr lst)))
  ))


; Signature: remove-last-item(lst)
; Type: [List(T1) => List(T1)]
; Purpose: return a list without the last item of lst
; Pre-conditions: (not (eq? lst '()))
; Tests: (remove-last-item '(1 2 3)) => '(1 2); (remove-last-item '(#t #f #f)) => '(#t #f)
(define remove-last-item
  (λ (lst)
    (if (eq? (cdr lst) '())
      '()
      (cons (car lst) (remove-last-item (cdr lst))))
  ))


; Signature: rotate-nth(lst, n)
; Type: [List(T1) * number => List(T1)]
; Purpose: rotate lst n times to the right
; Pre-conditions: (>= n 0)
; Tests: (rotate-nth '(1 2 3) 1) => '(3 1 2); (rotate-nth '(#t #f #f) 2) => '(#f #f #t)
(define rotate-nth
  (λ (lst n)
    (if (eq? lst '())
      '()
      (if (= n 0)
        lst
        (rotate-nth (cons (last-item lst) (remove-last-item lst)) (- n 1))
      )
    )
   ))


; Signature: deep-reverse(l)
; Type: [List(T1) => List(T1)]
; Purpose: returns a list with all elements from l reversed at every level of nesting
; Pre-conditions: true
; Tests: (deep-reverse '(1 2 3)) => '(3 2 1); (deep-reverse '(1 (2 3) (4 5))) => '((5 4) (3 2) 1); (deep-reverse '()) => '()
(define deep-reverse
  (λ (l)
    (deep-reverse-helper l '())  
  ))


; Signature: deep-reverse-helper(lst, acc)
; Type: [List(T1)*List(T1) => List(T1)]
; Purpose: Accumulate the reversed elements of lst into acc, reversing nested lists as well.
; Pre-conditions: true
; Tests: (deep-reverse-helper '(1 2 3) '()) => '(3 2 1); (deep-reverse-helper '(1 (2 3) (4 5)) '()) => '((5 4) (3 2) 1); (deep-reverse-helper '() '()) => '()
(define deep-reverse-helper
  (λ (lst acc)
    (if (eq? lst '())
      acc
      (if (pair? (car lst))
        (deep-reverse-helper (cdr lst) (cons (deep-reverse-helper (car lst) '()) acc))
        (deep-reverse-helper (cdr lst) (cons (car lst) acc))
      )
    )  
  ))